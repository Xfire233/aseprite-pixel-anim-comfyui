# All optional. Set as real environment variables (this file is documentation; nothing reads .env automatically).

# Only needed if this repo is NOT inside ComfyUI/custom_nodes/
ASEPRITE_WF_COMFY_ROOT=
# Only needed if Aseprite is not on PATH or in the usual Steam / Program Files location
ASEPRITE_WF_ASEPRITE=
# ComfyUI address for the CLI scripts
ASEPRITE_WF_COMFY_API=http://127.0.0.1:8188

# Optional LLM prompt compiler / charcard extractor (any OpenAI-compatible endpoint). Leave empty to use the
# built-in local template compiler, which needs no network.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Only if a Hugging Face download returns 401 (gated mirror)
HF_TOKEN=
